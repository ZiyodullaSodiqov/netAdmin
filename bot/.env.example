# --- Telegram bot ---
BOT_TOKEN=123456:ABC...
# Adminlar (vergul bilan), ularga qo'lda tekshiruv va chop etish buyurtmalari keladi
ADMIN_IDS=111111111
# Majburiy obuna kanallari (@username yoki -100... id, vergul bilan). Bot kanalda admin bo'lishi shart
REQUIRED_CHANNELS=@mening_kanalim

# --- AI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- To'lov ---
# Mijoz pul o'tkazadigan karta (ekranda ko'rsatiladi)
CARD_NUMBER=8600 0000 0000 0000
CARD_OWNER=Ism Familiya
# Kartani to'ldirganda xabar yuboradigan bot (masalan @CardXabarBot yoki bankingiz boti)
NOTIFY_BOT_USERNAME=@CardXabarBot
# Userbot: o'sha xabarlarni o'qish uchun SIZNING Telegram akkauntingiz (my.telegram.org dan)
TG_API_ID=1234567
TG_API_HASH=abcdef...
# python -m app.payments.login orqali olinadigan session satri
TG_SESSION_STRING=
# Chek vaqti bilan karta xabari vaqti orasidagi ruxsat etilgan farq (daqiqa)
PAYMENT_TIME_TOLERANCE_MIN=5
# Chek buyurtma yaratilgandan keyin necha daqiqa ichida bo'lishi kerak
PAYMENT_MAX_AGE_MIN=120
# Karta xabari kechiksa, necha soniya kutib qayta tekshiradi
PAYMENT_WAIT_SEC=90
# Vaqt mintaqasi (chek va karta xabaridagi vaqtlar shu mintaqada)
TZ_OFFSET_HOURS=5

# --- Boshqa ---
DB_PATH=data/bot.db
WORK_DIR=data/files
# Shriftlar (kirill harflari uchun)
FONT_REGULAR=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
FONT_SERIF_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSerif-Bold.ttf
FONT_SERIF=/usr/share/fonts/truetype/dejavu/DejaVuSerif.ttf
# Test xizmati narxi (topshiriqda ko'rsatilmagan)
PRICE_TESTS=5000
