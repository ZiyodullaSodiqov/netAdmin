# ====== Telegram bot (yordamchi bilan muloqot) ======
# @BotFather → /newbot → token
TELEGRAM_BOT_TOKEN=123456789:AAAA...
# O'zingizning Telegram ID raqamingiz (bilmasangiz: `python -m yordamchi login` ko'rsatadi yoki @userinfobot)
OWNER_ID=123456789

# ====== Userbot — o'z akkauntingiz, FAQAT O'QISH ======
# https://my.telegram.org → API development tools
USERBOT_ENABLED=true
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef
TG_PHONE=+998901234567

# ====== AI ======
# Asosiy provayder: gemini yoki openai. AI_FALLBACK=true bo'lsa, biri ishlamasa ikkinchisiga o'tadi.
AI_PROVIDER=gemini
AI_FALLBACK=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ====== Vaqt, eslatmalar, ob-havo ======
TIMEZONE=Asia/Tashkent
DAILY_BRIEF_TIME=08:00
# Vaqti aytilmagan vazifalar uchun standart soat
DEFAULT_TASK_TIME=09:00
# Necha daqiqa oldin eslatish (1440 = 1 kun, 0 = vaqti kelganda)
REMINDER_OFFSETS=1440,60,15,0
WEATHER_CITY=Toshkent
WEATHER_LAT=41.3111
WEATHER_LON=69.2797

# ====== Web sahifa ======
WEB_ENABLED=true
# 127.0.0.1 — faqat shu kompyuterdan ochiladi. Tarmoqdan ochmoqchi bo'lsangiz 0.0.0.0 va albatta WEB_TOKEN qo'ying.
WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_TOKEN=

# ====== Ma'lumotlar ======
DATA_DIR=./data
# Birinchi ishga tushganda har bir chatdan nechta oxirgi xabar o'qilsin (0 = o'qilmasin)
HISTORY_BACKFILL=200
# Har kuni shu vaqtda barcha chatlar qayta sinxronlanadi (oflayn paytdagi xabarlar ham)
DAILY_SYNC_TIME=08:00
# Chatlardagi rasm/ovoz/fayllarni ham diskka saqlash
STORE_MEDIA=false
STORE_MEDIA_MAX_MB=20

# ====== Chatlarni tahlil qilish ======
# Shaxsiy chatlarda sizga berilgan topshiriqlarni topib, botda taklif qilish
CHAT_TASK_DETECTION=true
CHAT_SCAN_INTERVAL_MIN=15
# Guruhlarni ham tahlil qilish
CHAT_SCAN_GROUPS=false
# Shaxsiy chatlardagi ovozli xabarlarni matnga aylantirish (AI xarajati oshadi)
TRANSCRIBE_CHAT_VOICES=false
